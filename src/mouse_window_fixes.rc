// Version stamp of MouseWindowFixes.asi (Properties > Details in Explorer).
#include <winver.h>

#define MWF_VERSION 1, 0, 1, 0
#define MWF_VERSION_STR "1.0.1"

VS_VERSION_INFO VERSIONINFO
FILEVERSION MWF_VERSION
PRODUCTVERSION MWF_VERSION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Strahlimeier"
            VALUE "FileDescription", "Mouse & Window Fixes for Crimson Desert"
            VALUE "FileVersion", MWF_VERSION_STR
            VALUE "InternalName", "MouseWindowFixes"
            VALUE "LegalCopyright", "MIT licence"
            VALUE "OriginalFilename", "MouseWindowFixes.asi"
            VALUE "ProductName", "Mouse & Window Fixes"
            VALUE "ProductVersion", MWF_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
